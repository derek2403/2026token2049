{
  "name": "mpc-relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SODA relayer: on SigCompleted, assembles the signed EthTxRequested (or SuiTxRequested) transaction and broadcasts it.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/events.test.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

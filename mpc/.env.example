# mpc/.env — read by the subscriber, the relayer and update-committee.
# Copy to mpc/.env (gitignored). The nodes and the coordinator take their
# config from the process environment only (see node/.env.example).

# ---- Solana ---------------------------------------------------------------
# Must serve logsSubscribe (Alchemy's free devnet tier does not).
SOLANA_RPC_URL=https://api.devnet.solana.com

# ---- Subscriber -----------------------------------------------------------
MPC_COORDINATOR_URL=http://127.0.0.1:8000
# Must equal the coordinator's MPC_AUTH_TOKEN.
MPC_COORDINATOR_TOKEN=
# Fee payer for finalize_signature: a keypair file path, or the 64-number
# JSON array inline (for hosts with no filesystem). Never commit either.
# ANCHOR_WALLET=
# ANCHOR_WALLET_JSON=

# ---- Relayer --------------------------------------------------------------
# EVM RPC the relayer broadcasts to, and which chain it serves.
SEPOLIA_RPC_URL=https://sepolia.base.org
DEMO_CHAIN=base-sepolia
# Optional Sui path: sui-testnet (default) | sui-devnet.
# SUI_CHAIN=sui-testnet

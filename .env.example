# Copy to .env and fill in. Never commit .env. Names only here, no values.

# --- Base Sepolia (server only: a keyed URL must not reach the browser) ---
# JSON-RPC, e.g. an Alchemy URL. Default: https://sepolia.base.org
BASE_RPC_URL=

# --- Solana ---
# Server-side devnet RPC (keyed Helius/Alchemy recommended). Default: https://api.devnet.solana.com
SOLANA_RPC_URL=
# Optional logsSubscribe WebSocket for the solver. Default: off. When it is off, the solver polls
# getSignaturesForAddress over SOLANA_RPC_URL instead. Leave it empty rather than "off": witness-cli
# reads this too, and uses its own default when it is empty.
SOLANA_WS_URL=
# Browser-visible devnet RPC and WebSocket for the Next.js app (no secrets here).
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_WS_URL=
# Program ID overrides; the defaults in lib/intents/constants.ts are the deployed devnet programs.
INTENTS_PROGRAM_ID=
NEXT_PUBLIC_INTENTS_PROGRAM_ID=
NEXT_PUBLIC_SODA_PROGRAM_ID=

# --- Solver bot (services/solver) ---
# Solver authority keypair: a 64-byte JSON array (Railway) or a path to a keypair file (local).
SOLVER_KEYPAIR_JSON=
SOLVER_KEYPAIR_PATH=
# Operator's funded Base Sepolia wallet private key, 0x + 64 hex. Secret.
BOT_ID=

# --- Local operator tooling ---
# Base58 Solana secret key for local scripts. Secret.
SOL_KEY=

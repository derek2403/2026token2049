# Copy to cre/.env (gitignored) and fill in. Never commit the real file.

# Solana devnet RPC used for the on_report write, e.g. https://api.devnet.solana.com
# or a keyed devnet endpoint (the public one rate-limits with 429).
CRE_SOLANA_RPC_URL=

# Funded devnet keypair: a path to a Solana CLI keypair file, or a 64-byte base58
# secret. Pays the on_report write; required even for dry runs.
CRE_SOLANA_PRIVATE_KEY=

# Any valid 64-hex EVM key. The CLI requires it even for Solana-only workflows; its
# address is probably the workflow_owner written into the report metadata.
CRE_ETH_PRIVATE_KEY=

# Base Sepolia JSON-RPC URL (a keyed Alchemy URL is fine), exposed to the workflow as secret BASE_RPC_URL.
BASE_RPC_URL_ALL=

# soda-signer: Solana devnet JSON-RPC URL (https) for reading SigRequests, exposed as secret SOLANA_RPC_URL.
SOLANA_RPC_URL_ALL=

# soda-signer: MPC coordinator bearer token, exposed as secret MPC_COORDINATOR_TOKEN.
MPC_COORDINATOR_TOKEN_ALL=
